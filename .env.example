# Postgres connection string (local Docker Postgres: `pnpm db:up`)
DATABASE_URL=postgres://finnance:finnance@localhost:5432/finnance
# Session signing secret, 32+ characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (on Vercel previews this is derived from VERCEL_URL)
BETTER_AUTH_URL=http://localhost:3000
# Open signup only when exactly "true". Keep false; the owner is created with `pnpm create-owner`.
ALLOW_SIGNUP=false
# Anthropic API key (not used until Phase 2b)
ANTHROPIC_API_KEY=
